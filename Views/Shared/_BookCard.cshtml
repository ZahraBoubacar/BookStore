@model Book

<div class="book-card">
    <a href="/livres/details/@Model.Slug" class="book-card-img-link">
        <div class="book-badges">
            @if (Model.IsNew) { <span class="badge badge--new">Nouveau</span> }
            @if (Model.IsOnSale) { <span class="badge badge--sale">-@Model.DiscountPercent%</span> }
            @if (Model.IsBestseller && !Model.IsNew && !Model.IsOnSale) { <span class="badge badge--bestseller">Bestseller</span> }
        </div>
        <img src="@Model.CoverImageUrl" alt="@Model.Title" class="book-cover" loading="lazy" onerror="this.src='/images/book-placeholder.svg'" />
        <div class="book-hover-overlay"><span>Voir les détails</span></div>
    </a>
    <div class="book-card-body">
        <p class="book-category">@Model.Category.Name</p>
        <h3 class="book-title"><a href="/livres/details/@Model.Slug">@Model.Title</a></h3>
        <p class="book-author">@Model.Author.Name</p>
        <div class="book-rating">
            @for (int i = 1; i <= 5; i++) { <span class="star @(i <= Math.Round(Model.Rating) ? "star--filled" : "")">★</span> }
            <span class="rating-count">(@Model.ReviewCount)</span>
        </div>
        <div class="book-footer">
            <div class="book-price-group">
                @if (Model.IsOnSale) { <span class="book-price-original">@CurrencyHelper.FormatTND(Model.OriginalPrice!.Value)</span> }
                <span class="book-price @(Model.IsOnSale ? "book-price--sale" : "")">@CurrencyHelper.FormatTND(Model.Price)</span>
            </div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form action="/panier/AddFromDetails" method="post">
                    <input type="hidden" name="bookId" value="@Model.Id" />
                    <input type="hidden" name="returnUrl" value="/livres" />
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-add-cart" title="Ajouter au panier">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
                    </button>
                </form>
            }
            else
            {
                <a href="/compte/connexion" class="btn-add-cart btn-add-cart--lock" title="Connectez-vous pour acheter">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
                </a>
            }
        </div>
    </div>
</div>
