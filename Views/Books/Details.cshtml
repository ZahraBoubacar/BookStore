@model BookDetailViewModel
@{
    var book = Model.Book;
    ViewData["Title"] = book.Title;
    ViewBag.Categories = new List<BookStore.Models.Category>();
}

<div class="book-detail-page">
    <div class="container">
        <nav class="breadcrumb">
            <a href="/">Accueil</a> <span>/</span>
            <a href="/livres">Catalogue</a> <span>/</span>
            <a href="/livres?categoryId=@book.CategoryId">@book.Category.Name</a> <span>/</span>
            <span>@book.Title</span>
        </nav>

        <div class="book-detail-grid">
            <!-- Cover -->
            <div class="book-detail-cover">
                <div class="cover-wrapper">
                    @if (book.IsNew) { <span class="badge badge--new badge--lg">Nouveau</span> }
                    @if (book.IsOnSale) { <span class="badge badge--sale badge--lg">-@book.DiscountPercent%</span> }
                    <img src="@book.CoverImageUrl" alt="@book.Title" class="detail-cover-img"
                         onerror="this.src='/images/book-placeholder.svg'" />
                </div>
                <div class="book-meta-grid">
                    <div class="book-meta-item">
                        <span class="meta-label">Pages</span>
                        <span class="meta-value">@book.Pages</span>
                    </div>
                    <div class="book-meta-item">
                        <span class="meta-label">Langue</span>
                        <span class="meta-value">@book.Language</span>
                    </div>
                    <div class="book-meta-item">
                        <span class="meta-label">Éditeur</span>
                        <span class="meta-value">@book.Publisher</span>
                    </div>
                    <div class="book-meta-item">
                        <span class="meta-label">Publication</span>
                        <span class="meta-value">@book.PublishedDate.Year</span>
                    </div>
                    <div class="book-meta-item" style="grid-column:1/-1">
                        <span class="meta-label">ISBN</span>
                        <span class="meta-value meta-value--mono">@book.ISBN</span>
                    </div>
                </div>
            </div>

            <!-- Info -->
            <div class="book-detail-info">
                <p class="detail-category">
                    <a href="/livres?categoryId=@book.CategoryId">@book.Category.Icon @book.Category.Name</a>
                </p>
                <h1 class="detail-title">@book.Title</h1>
                <a href="/auteurs/details/@book.AuthorId" class="detail-author">par @book.Author.Name</a>

                <div class="detail-rating">
                    <div class="stars-large">
                        @for (int i = 1; i <= 5; i++)
                        { <span class="star @(i <= Math.Round(book.Rating) ? "star--filled" : "")">★</span> }
                    </div>
                    <span class="rating-num">@book.Rating.ToString("F1")</span>
                    <span class="rating-count">(@book.ReviewCount avis)</span>
                </div>

                <div class="tags">
                    @foreach (var tag in book.Tags) { <span class="tag">@tag</span> }
                </div>

                <!-- Purchase Box -->
                <div class="detail-purchase">
                    <div class="detail-price-group">
                        @if (book.IsOnSale)
                        {
                            <span class="detail-price-original">@CurrencyHelper.FormatTND(book.OriginalPrice!.Value)</span>
                        }
                        <span class="detail-price">@CurrencyHelper.FormatTND(book.Price)</span>
                        @if (book.IsOnSale)
                        {
                            <span class="detail-saving">Vous économisez @CurrencyHelper.FormatTND(book.OriginalPrice!.Value - book.Price)</span>
                        }
                    </div>

                    @if (book.IsAvailable)
                    {
                        <div class="availability available">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                            En stock — Expédition sous 24h
                        </div>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form action="/panier/AddFromDetails" method="post" class="add-to-cart-form">
                                <input type="hidden" name="bookId" value="@book.Id" />
                                <input type="hidden" name="returnUrl" value="/livres/details/@book.Slug" />
                                @Html.AntiForgeryToken()
                                <div class="quantity-row">
                                    <div class="quantity-picker">
                                        <button type="button" class="qty-btn" onclick="changeQty(-1)">−</button>
                                        <input type="number" name="quantity" id="qty" value="1" min="1" max="10" class="qty-input" />
                                        <button type="button" class="qty-btn" onclick="changeQty(1)">+</button>
                                    </div>
                                    <button type="submit" class="btn btn--primary btn--lg">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
                                            <line x1="3" y1="6" x2="21" y2="6"/>
                                            <path d="M16 10a4 4 0 01-8 0"/>
                                        </svg>
                                        Ajouter au panier
                                    </button>
                                </div>
                            </form>
                        }
                        else
                        {
                            <div class="auth-required-box">
                                <p>🔒 Connectez-vous pour acheter ce livre</p>
                                <div style="display:flex;gap:10px;margin-top:12px">
                                    <a href="/compte/connexion?returnUrl=/livres/details/@book.Slug" class="btn btn--primary">Se connecter</a>
                                    <a href="/compte/inscription" class="btn btn--outline">Créer un compte</a>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="availability unavailable">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                            Temporairement indisponible
                        </div>
                    }
                </div>

                <div class="detail-description">
                    <h2>À propos de ce livre</h2>
                    <p>@book.Description</p>
                </div>
            </div>
        </div>

        <!-- Author -->
        <div class="author-section">
            <div class="author-card">
                <div class="author-avatar">
                    <img src="@book.Author.PhotoUrl" alt="@book.Author.Name"
                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'" />
                    <div class="author-avatar-fallback">@book.Author.Name[0]</div>
                </div>
                <div class="author-info">
                    <p class="author-label">À propos de l'auteur</p>
                    <h3 class="author-name">@book.Author.Name</h3>
                    <p class="author-nationality">@book.Author.Nationality · né en @book.Author.BirthYear</p>
                    <p class="author-bio">@book.Author.Bio</p>
                    @if (book.Author.Awards.Any())
                    {
                        <div class="awards">
                            @foreach (var award in book.Author.Awards)
                            { <span class="award">🏆 @award</span> }
                        </div>
                    }
                    <a href="/auteurs/details/@book.AuthorId" class="author-link">Voir tous ses livres →</a>
                </div>
            </div>
        </div>

        <!-- Reviews -->
        @if (book.Reviews.Any())
        {
            <div class="reviews-section">
                <h2 class="section-title-sm">Avis des lecteurs</h2>
                <div class="reviews-grid">
                    @foreach (var review in book.Reviews)
                    {
                        <div class="review-card">
                            <div class="review-header">
                                <div class="review-avatar">@review.Avatar</div>
                                <div>
                                    <p class="review-name">@review.ReviewerName</p>
                                    <div class="review-stars">
                                        @for (int i = 1; i <= 5; i++)
                                        { <span class="star @(i <= review.Rating ? "star--filled" : "")">★</span> }
                                    </div>
                                </div>
                                <time class="review-date">@review.Date.ToString("d MMM yyyy")</time>
                            </div>
                            <p class="review-comment">@review.Comment</p>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Related -->
        @if (Model.RelatedBooks.Any())
        {
            <div class="related-section">
                <div class="section-header">
                    <h2 class="section-title">Vous aimerez aussi</h2>
                    <a href="/livres?categoryId=@book.CategoryId" class="see-all">Voir plus →</a>
                </div>
                <div class="books-grid">
                    @foreach (var related in Model.RelatedBooks)
                    { <partial name="_BookCard" model="related" /> }
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
function changeQty(delta) {
    const input = document.getElementById('qty');
    input.value = Math.max(1, Math.min(10, parseInt(input.value) + delta));
}
</script>
}
